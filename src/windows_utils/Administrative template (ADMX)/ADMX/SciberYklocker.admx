<?xml version="1.0" encoding="utf-8"?>
<policyDefinitions revision="1.0" schemaVersion="1.0">
  <policyNamespaces>
    <target prefix="Sciber" namespace="Sciber.Policies"/>
  </policyNamespaces>
  <resources minRequiredRevision="1.0"/>
  <supportedOn>
    <definitions>
      <definition name="SUPPORTED_Windows_10_0_NOSERVER" displayName="$(string.SupportedWindows)"/>
    </definitions>
  </supportedOn>
  <categories>
    <category name="Sciber" displayName="$(string.Sciber)"/>
    <category name="SciberPolicies" displayName="$(string.SciberPolicies)"><parentCategory ref="Sciber"/></category>
  </categories>
  <policies>
    <policy name="SciberYklocker" class="Machine" displayName="$(string.SciberYklocker)" explainText="$(string.SciberYklocker_Help)" presentation="$(presentation.SciberYklocker)" key="Software\Policies\Sciber\YubiKey Removal Behavior">
      <parentCategory ref="SciberPolicies"/>
      <supportedOn ref="Sciber:SUPPORTED_Windows_10_0_NOSERVER"/>
      <disabledList><item key="Software\Policies\Sciber\YubiKey Removal Behavior" valueName="RemovalOption"><value><string>doNothing</string></value></item></disabledList>
      <elements>
        <enum id="RemovalOption" valueName="RemovalOption" required="true">
          <item displayName="$(string.Lock)">
            <value>
              <string>Lock</string>
            </value>
          </item>
          <item displayName="$(string.Logout)">
            <value>
              <string>Logout</string>
            </value>
          </item>
          <item displayName="$(string.doNothing)">
            <value>
              <string>doNothing</string>
            </value>
          </item>
        </enum>
      </elements>
    </policy>
  </policies>
</policyDefinitions>
