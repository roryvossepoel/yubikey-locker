<policyDefinitionResources revision="1.0" schemaVersion="1.0">
  <displayName>Sciber Policy Definitions</displayName>
  <description>Sciber Policy Definitions</description>
  <resources>
    <stringTable>
      <string id="SupportedWindows">Windows 10 or later (desktop editions)</string>
      <string id="Sciber">Sciber YubiKey Locker</string>
      <string id="SciberPolicies">Sciber YubiKey Locker Settings</string>
      <string id="SciberYklocker">Sciber YubiKey Locker Settings</string>
      <string id="SciberYklocker_Help">Policy settings for Sciber YubiKey Locker.

* removalOption sets what action to take once when a YubiKey USB removal event is received. Signing in without a key does not trigger an action.
Actions are immediate. Only the active local console session is targeted.
Disabled or not configured: no action. Old Timeout values are ignored.

</string>
      <string id="Lock">Lock</string>
      <string id="Logout">Logout</string>
      <string id="doNothing">doNothing</string>

      <string id="RemovalOptionLabel">Removal option:</string>
    </stringTable>
    <presentationTable>
      <presentation id="SciberYklocker">
        <dropdownList refId="RemovalOption" defaultItem="0">RemovalOption:</dropdownList>
      </presentation>
    </presentationTable>
  </resources>
</policyDefinitionResources>
